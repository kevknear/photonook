    "One iOS confirmation for the whole batch. Unmarked photos count as kept; press and hold a photo to send it back to the deck." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola confirmación de iOS para todo el lote. Las sin marcar quedan como conservadas; mantén pulsada una foto para devolverla al mazo."
          }
        }
      }
    },
    "One system alert per photo. That's iOS behavior and it can't be turned off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una alerta del sistema por cada foto. Es el comportamiento que impone iOS y no se puede desactivar."
          }
        }
      }
    },
